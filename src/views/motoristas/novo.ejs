
<section>
    <h1>Novo Motorista</h1>

    <% if (erros.length > 0) { %>
        <div class="alert error">
            <ul>
                <% erros.forEach(erro => { %>
                    <li><%= erro %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form method="POST" action="/motoristas">

        <div>
            <label for="nome">Nome</label>
            <input
                    type="text"
                    id="nome"
                    name="nome"
                    value="<%= dados.nome %>"
                    required
            >
        </div>

        <div>
            <label for="cpf">CPF</label>
            <input
                    type="text"
                    id="cpf"
                    name="cpf"
                    value="<%= dados.cpf %>"
                    required
            >
        </div>

        <div>
            <label for="placaVeiculo">
                Placa do veículo (opcional)
            </label>

            <input
                    type="text"
                    id="placaVeiculo"
                    name="placaVeiculo"
                    value="<%= dados.placaVeiculo || '' %>"
            >
        </div>

        <button type="submit">
            Cadastrar Motorista
        </button>

        <a href="/motoristas">Cancelar</a>
    </form>
</section>
